PORT=4000
NODE_ENV=development
# Use a real MongoDB, or "memory" for an ephemeral local database (not for production).
MONGODB_URI=mongodb://127.0.0.1:27017/devcollab
JWT_SECRET=replace-with-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
CLIENT_DIST=../client/dist
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Set to true to insert the Northwind demo workspace on boot (memory mode or empty database).
SEED=false
